[sub_resource type="GDScript" id="GDScript_yhfrr"]
script/source = "extends CharacterBody2D
@onready var warmAni2_0 = $warmAni2_0
@onready var soundHurt:AudioStreamPlayer2D = $soundHurt
@onready var player:CharacterBody2D = $\"../player\"
@export var move_speed:float = 330.0
@export var target: CharacterBody2D

var follow:bool = true
var time_passed: float = 0.0
var wait_time: float = 2 # Wait for 2 seconds
func _ready() -> void:
	warmAni2_0.flip_h = true
	warmAni2_0.play(\"default\")


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	if follow == true:
		var direction = position.direction_to(player.global_position).normalized()
		velocity = direction * move_speed
		move_and_slide()
	else:
		var direction: Vector2 = global_position.direction_to(Vector2(473,572))
		velocity = direction * move_speed
		move_and_slide()
		
		#anime
		time_passed += delta
		if time_passed >= wait_time:
			#print(\"Timeout reached!\")
			if warmAni2_0.flip_h == true:
				warmAni2_0.flip_h = false
			else:
				warmAni2_0.flip_h = true
			time_passed = 0.0 # Reset the timer loop
			$AnimationPlayer.play(\"moving\")

func _physics_process(delta: float) -> void:
	# Add the gravity.
	if not is_on_floor():
		velocity += get_gravity() * delta
		
func _on_warm_area_2_0_body_entered(body: Node2D) -> void:
	Coman.hurt(body, soundHurt)
"

